# ==============================================================================
# YIN TECHNOLOGY PLATFORM - ENVIRONMENT CONFIGURATION
# Quản lý biến môi trường tách biệt giữa Hạ tầng (Database) và Ứng dụng (Web App)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HẠ TẦNG CƠ SỞ DỮ LIỆU (MICROSOFT SQL SERVER DOCKER)
# ------------------------------------------------------------------------------
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
MSSQL_ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=replace-with-a-strong-sql-server-password
MSSQL_PID=Developer
MSSQL_PORT=1433
MSSQL_DB_NAME=yin_tech_db
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
MSSQL_POOL_SIZE=10
MSSQL_DATA_VOLUME=yin_mssql_data

# ------------------------------------------------------------------------------
# 2. FRONTEND WEB APPLICATION (ANGULAR v22)
# ------------------------------------------------------------------------------
FRONTEND_PORT=4200
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_ENV=development

# ------------------------------------------------------------------------------
# 3. BACKEND SERVICE (JAVA SPRING BOOT 3)
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
JWT_SECRET=replace-with-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=3600000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password
APP_SEED_ENABLED=true
MEDIA_STORAGE_DIR=./media

# ------------------------------------------------------------------------------
# 4. THÔNG TIN DOANH NGHIỆP YIN
# ------------------------------------------------------------------------------
COMPANY_NAME="Công ty Công nghệ Yin"
COMPANY_OWNER="Khang"
COMPANY_EMAIL="contact@yin.vn"
COMPANY_HOTLINE="+84 900 123 456"

